      "id": 1,
      "title": "Application UP",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "foroushyar-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "foroushyar-prometheus"
          },
          "expr": "up{job=\"torob-rent\"}",
          "legendFormat": "{{route}}{{capability}}{{provider}}{{outcome}}{{direction}}",
          "instant": true
        }
      ],
      "description": "Authenticated private scrape; downtime sustained for 2 minutes alerts.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "decimals": 0
        },
        "overrides": []
      }
    },
