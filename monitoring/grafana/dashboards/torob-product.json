      "id": 1,
      "title": "Search sessions",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "torob-rent-postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "torob-rent-postgres"
          },
          "rawSql": "SELECT coalesce(sum(searches),0) AS searches FROM analytics_search_cohorts WHERE mode = '${mode}' AND $__timeFilter(time)",
          "format": "table",
          "editorMode": "code"
        }
      ],
      "description": "One durable server search execution is one search cohort; retries from client navigation can create a new search.",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "decimals": 0
        },
        "overrides": []
      }
    },
